# Build MemMachine from source and add missing dependencies
FROM python:3.12-slim-trixie AS builder

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y curl git build-essential libpq-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /uvx /usr/local/bin/

WORKDIR /app

# Clone MemMachine
RUN git clone https://github.com/MemMachine/MemMachine.git . && \
    git checkout main

# Install dependencies
RUN uv sync --locked --no-editable --no-dev

# Install psycopg2-binary explicitly
RUN .venv/bin/pip install psycopg2-binary

# Final stage
FROM python:3.12-slim-trixie AS final

RUN apt-get update && \
    apt-get install -y libpq5 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv

# Download NLTK data
RUN python -c "import sys; sys.path.insert(0, '/app/.venv/lib/python3.12/site-packages'); import nltk; nltk.download('punkt_tab'); nltk.download('stopwords')"

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app:$PYTHONPATH"

CMD ["memmachine-server"]
