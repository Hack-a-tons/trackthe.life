#ifndef WIFI_CONFIG_H
#define WIFI_CONFIG_H

// WiFi credentials
const char *WIFI_SSID = "YourWiFiName";
const char *WIFI_PASSWORD = "YourWiFiPassword";

// Backend server configuration
const char *BACKEND_HOST = "192.168.1.100";  // Change to your laptop's IP
const int BACKEND_PORT = 4000;
const char *UPLOAD_ENDPOINT = "/api/media";

// Device identification
const char *USER_ID = "esp32-cam-01";

// Capture settings
const unsigned long CAPTURE_INTERVAL_MS = 5000;  // Capture every 5 seconds

#endif
