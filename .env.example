# Server configuration
PORT=4000
EXTERNAL_PORT=6000

# Public URL (for ESP32 and external access)
PUBLIC_URL=https://trackthelife.hurated.com

# ApertureDB configuration
# Cloud: https://aperturedata.io (recommended)
# Use "Host Name" from dashboard (e.g., your-instance.farm0004.cloud.aperturedata.io)
# Use "Auth Token" from dashboard as API key
APERTUREDB_URL=your-instance.farm0004.cloud.aperturedata.io
APERTUREDB_API_KEY=adbp_your_auth_token_here

# Telnyx configuration
# Cloud: https://portal.telnyx.com (get API key from dashboard)
TELNYX_API_KEY=your_telnyx_api_key_here

# MemMachine configuration (Docker service)
# Runs as part of docker-compose stack
MEMMACHINE_PORT=7000
MEMMACHINE_URL=http://localhost:7000
MEMMACHINE_DB_PASSWORD=change_this_password
MEMMACHINE_NEO4J_PASSWORD=change_this_password

# Option 1: OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# Option 2: Azure OpenAI (recommended for enterprise)
# Get from: https://portal.azure.com
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Comet/Opik configuration
# Cloud: https://www.comet.com (get API key from settings)
COMET_API_KEY=your_comet_api_key_here
COMET_WORKSPACE=trackthelife
